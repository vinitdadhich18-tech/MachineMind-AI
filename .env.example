# ===================================================================
# MachineMind AI — Industrial Stack Environment Configuration Template
# ===================================================================
# Copy this file to .env and fill in your actual HiveMQ Cloud credentials.
# NEVER commit the actual .env file or real secrets to Git.
# ===================================================================

# -------------------------------------------------------------------
# HiveMQ Cloud MQTT Broker Configuration (MQTT over TLS)
# -------------------------------------------------------------------
MQTT_BROKER_HOST=your-cluster-id.s1.eu.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your_hivemq_username
MQTT_PASSWORD=your_hivemq_password
MQTT_TOPIC_PREFIX=machinemind/v1
MQTT_MACHINE_ID=ims_set2_rig
MQTT_QOS=1
MQTT_USE_TLS=true

# -------------------------------------------------------------------
# Replay Simulator Options
# -------------------------------------------------------------------
SIMULATOR_REPLAY_INTERVAL_SEC=1.0
SIMULATOR_DATASET_PATH=ml-service/data/raw/IMS/2nd_test/2nd_test

# -------------------------------------------------------------------
# Flask Backend Configuration (Legacy / Admin)
# -------------------------------------------------------------------
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=0
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=machinemind

# -------------------------------------------------------------------
# Streamlit Dashboard Configuration (Legacy UI)
# -------------------------------------------------------------------
BACKEND_URL=http://localhost:5000
