# ==========================================
# MachineMind AI - Git Ignore Specification
# ==========================================

# 1. Python Cache & Compiled Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# 2. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
ml-service/venv/
ml-service/.venv/

# 3. Jupyter Notebook Checkpoints & Cache
.ipynb_checkpoints
*/.ipynb_checkpoints/*
.ipython/

# 4. Environment Variables & Secrets
.env
.env.*
*.env
.venv

# 5. Data Files (Exclude raw data dumps & processed datasets, preserve structure)
ml-service/data/raw/*
!ml-service/data/raw/.gitkeep
ml-service/data/processed/*
!ml-service/data/processed/.gitkeep
*.csv
*.parquet
*.h5
*.hdf5
*.feather

# 6. Generated ML Model Files & Artifacts
ml-service/models/*
!ml-service/models/.gitkeep
*.pkl
*.joblib
*.pth
*.pt
*.onnx
*.h5
*.pb

# 7. Generated Reports & Output Figures
ml-service/reports/*
!ml-service/reports/.gitkeep

# 8. IDE & System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
