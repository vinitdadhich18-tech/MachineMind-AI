{
  "model_name": "MachineMind AI Vibration Anomaly Detector",
  "version": "1.0.0",
  "creation_date": "2026-09-30 06:00:50 UTC",
  "task": "Unsupervised Vibration Anomaly Detection",
  "provenance": {
    "dataset": "NASA IMS Bearing Dataset",
    "subset": "Set 2",
    "citation": "J. Lee et al. (2007). IMS, University of Cincinnati. NASA Prognostics Data Repository.",
    "file_range": "2004.02.12.01.05.39 to 2004.02.19.06.22.39 (984 snapshots)",
    "healthy_period_definition": "Snapshots 0 to 159 (first ~26.7 hours, assumed healthy)",
    "calibration_period_definition": "Snapshots 160 to 179 (~3.3 hours)"
  },
  "preprocessing_parameters": {
    "sampling_rate_hz": 20000,
    "snapshot_points": 20480,
    "duration_seconds": 1.024,
    "dc_offset_removal": true,
    "channels": [
      "ch1",
      "ch2",
      "ch3",
      "ch4"
    ]
  },
  "feature_extraction": {
    "feature_set_type": "time_domain_28",
    "features_per_channel": [
      "mean",
      "std",
      "rms",
      "p2p",
      "skewness",
      "kurtosis",
      "crest_factor"
    ],
    "total_features": 28,
    "ordered_feature_names": [
      "ch1_mean",
      "ch1_std",
      "ch1_rms",
      "ch1_p2p",
      "ch1_skewness",
      "ch1_kurtosis",
      "ch1_crest_factor",
      "ch2_mean",
      "ch2_std",
      "ch2_rms",
      "ch2_p2p",
      "ch2_skewness",
      "ch2_kurtosis",
      "ch2_crest_factor",
      "ch3_mean",
      "ch3_std",
      "ch3_rms",
      "ch3_p2p",
      "ch3_skewness",
      "ch3_kurtosis",
      "ch3_crest_factor",
      "ch4_mean",
      "ch4_std",
      "ch4_rms",
      "ch4_p2p",
      "ch4_skewness",
      "ch4_kurtosis",
      "ch4_crest_factor"
    ]
  },
  "scaler": {
    "type": "RobustScaler",
    "fit_window": "snapshots 0..159"
  },
  "models": {
    "iforest": {
      "type": "IsolationForest",
      "hyperparameters": {
        "n_estimators": 100,
        "max_samples": "auto",
        "contamination": "auto",
        "random_state": 42
      },
      "channel_thresholds_P99": {
        "ch1": 0.5131679214172415,
        "ch2": 0.4725104927977178,
        "ch3": 0.6225579020689226,
        "ch4": 0.5066280904227561
      }
    },
    "pca": {
      "type": "PCA",
      "hyperparameters": {
        "n_components": 3,
        "random_state": 42
      },
      "channel_thresholds_P99": {
        "ch1": 0.4607796619183697,
        "ch2": 0.3964954377675045,
        "ch3": 0.19459781785525562,
        "ch4": 0.5036928042229392
      }
    }
  },
  "decision_logic": {
    "persistence_k": 3,
    "system_alert_policy": "Logical OR across channels"
  },
  "environment": {
    "python_version": "3.14.2",
    "numpy_version": "2.5.3",
    "pandas_version": "3.0.6",
    "scikit_learn_version": "1.9.1",
    "joblib_version": "1.6.0"
  },
  "limitations_and_intended_use": [
    "Research/learning prototype based on NASA IMS laboratory dataset.",
    "Single run-to-failure trajectory under constant speed (~2000 RPM) and radial load (6000 lbs).",
    "Does NOT predict remaining useful life (RUL) or exact failure time.",
    "Anomaly alert indicates statistical deviation from baseline, not specific physical defect classification."
  ]
}